// ===== Model =====
// Fact: washington_crimes_clean   Dim: Date (see below)   Dim: Hour (0-23)   Dim: Weekday (Mon=1..Sun=7)
// Relationships: Date[Date] 1:* Fact[report_date]; Hour[Hour] 1:* Fact[hour]; Weekday[Num] 1:* Fact[weekday_num]
// Mark Date as the date table. Hide all fact columns that are only used through measures.

Hour    = SELECTCOLUMNS ( GENERATESERIES ( 0, 23 ), "Hour", [Value] )
Weekday = DATATABLE ( "Num", INTEGER, "Name", STRING, { {1,"Mon"},{2,"Tue"},{3,"Wed"},{4,"Thu"},{5,"Fri"},{6,"Sat"},{7,"Sun"} } )

Date = ADDCOLUMNS ( CALENDAR ( DATE ( 2025, 1, 1 ), DATE ( 2025, 2, 28 ) ),
    "Month", FORMAT ( [Date], "mmm" ), "Week", WEEKNUM ( [Date], 2 ), "Weekday", FORMAT ( [Date], "ddd" ) )

// ===== Base =====
Crimes        = COUNTROWS ( washington_crimes_clean )
Violent       = CALCULATE ( [Crimes], washington_crimes_clean[is_violent] = TRUE () )
Property      = [Crimes] - [Violent]
Gun           = CALCULATE ( [Crimes], washington_crimes_clean[is_gun] = TRUE () )
Days          = DISTINCTCOUNT ( washington_crimes_clean[report_date] )

// ===== Ratios =====
Violent %     = DIVIDE ( [Violent], [Crimes] )
Gun %         = DIVIDE ( [Gun], [Crimes] )
Per Day       = DIVIDE ( [Crimes], [Days] )
City Share    = DIVIDE ( [Crimes], CALCULATE ( [Crimes], ALL ( washington_crimes_clean ) ) )
7D Avg        = AVERAGEX ( DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -7, DAY ), [Crimes] )
Reported Same Day % = DIVIDE ( CALCULATE ( [Crimes], washington_crimes_clean[report_lag_days] = 0 ), [Crimes] )

// ===== Rankings (work under any filter) =====
Ward Rank (Volume)  = RANKX ( ALL ( washington_crimes_clean[ward] ), [Crimes] )
Ward Rank (Violent %) = RANKX ( ALL ( washington_crimes_clean[ward] ), [Violent %] )
Top Volume Ward  = VAR t = TOPN ( 1, ALL ( washington_crimes_clean[ward] ), [Crimes] ) RETURN "Ward " & MAXX ( t, washington_crimes_clean[ward] )
Top Violent Ward = VAR t = TOPN ( 1, ALL ( washington_crimes_clean[ward] ), [Violent %] ) RETURN "Ward " & MAXX ( t, washington_crimes_clean[ward] )

// ===== Measure switcher (disconnected table 'Metric': All | Violent | Gun) used by the heatmap =====
Metric = DATATABLE ( "Metric", STRING, "Order", INTEGER, { { "All", 1 }, { "Violent", 2 }, { "Gun", 3 } } )
Selected Metric =
SWITCH ( SELECTEDVALUE ( Metric[Metric], "All" ), "Violent", [Violent], "Gun", [Gun], [Crimes] )

// ===== Dynamic headlines (bind to text box / card 'Title' via fx) =====
Headline Brief =
FORMAT ( [Crimes], "#,0" ) & " crimes in " & [Days] & " days — "
    & FORMAT ( DIVIDE ( CALCULATE ( [Crimes], washington_crimes_clean[offense] IN { "theft/other", "theft f/auto", "motor vehicle theft" } ), [Crimes] ), "0%" )
    & " were theft, only " & FORMAT ( [Violent %], "0%" ) & " violent"

Headline Where = [Top Volume Ward] & " has the volume. " & [Top Violent Ward] & " has the violence."

Peak Hour = VAR t = TOPN ( 1, ALL ( 'Hour'[Hour] ), [Crimes] ) RETURN MAXX ( t, 'Hour'[Hour] )
Headline When = "Crime peaks at " & FORMAT ( TIME ( [Peak Hour], 0, 0 ), "h AM/PM" ) & "; violence waits for night"

Insight Where =
VAR w = [Top Violent Ward]
RETURN w & " — " & FORMAT ( [Violent %], "0%" ) & " of crimes are violent and " & [Gun] & " involve a gun."

// ===== Conditional formatting helpers =====
Violent % Colour = IF ( [Violent %] >= 0.2, "#D1495B", IF ( [Violent %] >= 0.1, "#EDAE49", "#5B7C99" ) )
Heat Colour = VAR m = MAXX ( ALLSELECTED ( 'Hour'[Hour], Weekday[Num] ), [Selected Metric] )
              RETURN IF ( [Selected Metric] >= 0.75 * m, "#D1495B", BLANK () )
