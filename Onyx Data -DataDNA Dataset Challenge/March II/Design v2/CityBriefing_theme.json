{
  "name": "City Briefing",
  "dataColors": [
    "#5B7C99",
    "#D1495B",
    "#EDAE49",
    "#2A9D8F",
    "#8E7DBE",
    "#9AA5B1",
    "#264653",
    "#E76F51"
  ],
  "background": "#FFFFFF",
  "foreground": "#14213D",
  "tableAccent": "#D1495B",
  "good": "#2A9D8F",
  "neutral": "#EDAE49",
  "bad": "#D1495B",
  "maximum": "#D1495B",
  "center": "#F3E3C3",
  "minimum": "#FBF6EC",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#14213D"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#6B7280"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#14213D"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#14213D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#14213D"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 14,
            "right": 14
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E5E1D8"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F1EA"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}